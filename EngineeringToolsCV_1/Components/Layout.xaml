<UserControl x:Class="EngineeringToolsCV_1.Components.Layout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EngineeringToolsCV_1.Components"
             mc:Ignorable="d" 
             Height="730" 
             Width="850">
    <Grid>
        <local:NavigationBar 
            Width="800"
            Height="25"
            VerticalAlignment="Top"
            Margin="3,8,0,0"
            Background="AliceBlue"
            DataContext="{Binding NAvigationBarViewModel }"
            />
        <Rectangle 
            Fill="RoyalBlue" 
            Height="2" Width="790"
            VerticalAlignment="Top" 
            Margin="0,40,0,0"/>
        
        <Rectangle 
            Fill="RoyalBlue"
            Height="2" Width="790" 
            VerticalAlignment="Bottom" 
            Margin="0,0,0,40"/>
        
        <TextBlock 
            Width="150" 
            Height="20" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Bottom" 
            Margin="0,0,25,5" 
            FontSize="15" 
            Text="{Binding Path=StrDate}" />
        
        <TextBlock 
            Width="210" 
            Height="20" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Bottom" 
            Margin="0,0,25,5" 
            FontSize="15" 
            Text="{Binding Path=StrUserEmail}" />

            <ContentControl
             Content="{ Binding ContentViewModels}" 
             HorizontalAlignment="Center" 
             VerticalAlignment="Center" 
             BorderBrush="Transparent"
             Width="840" Height="740"/>
     
    </Grid>
</UserControl>
